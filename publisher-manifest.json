\"Microsoft YaHei\",system-ui,sans-serif;font-size:11px;letter-spacing:.18em;color:var(--violet);border:1px solid var(--violet-soft);padding:2px 8px;margin-bottom:12px}\n  .plan .pitch{margin:0 0 18px;font-size:15px;color:var(--ink-soft)}\n  .plan ul{list-style:none;margin:0;padding:0}\n  .plan ul li{font-size:14.5px;color:var(--ink-soft);padding:7px 0 7px 20px;border-top:1px solid var(--line);position:relative}\n  .plan ul li::before{content:\"—\";position:absolute;left:0;color:var(--violet)}\n  .price-block{border-top:2px solid var(--ink);padding-top:14px}\n  .price{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:30px;font-weight:800;letter-spacing:-0.02em;margin:0}\n  .price small{font-size:13px;font-weight:400;color:var(--ink-faint);margin-left:2px}\n  .price-note{margin:8px 0 0;font-size:13.5px;color:var(--ink-soft)}\n  .price-foot{margin:14px 0 0;font-size:12.5px;color:var(--ink-faint);line-height:1.6}\n\n  /* ---------- 客户端 / 使用说明 ---------- */\n  .steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 34px}\n  .step{border-top:1px solid var(--line);padding:20px 0 22px}\n  .step .num{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:12px;letter-spacing:.2em;color:var(--violet);display:block;margin-bottom:6px}\n  .step h3{font-size:16.5px;margin:0 0 6px}\n  .step p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n  /* ---------- FAQ：details 折叠 ---------- */\n  .faq{display:grid;grid-template-columns:minmax(0,1fr);gap:0;max-width:52em}\n  details{border-top:1px solid var(--line);padding:4px 0}\n  details:last-of-type{border-bottom:1px solid var(--line)}\n  summary{cursor:pointer;list-style:none;padding:16px 34px 16px 0;position:relative;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:16px;font-weight:600;color:var(--ink)}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";position:absolute;right:6px;top:14px;font-size:20px;font-weight:400;color:var(--violet);line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details p{margin:0 0 18px;font-size:14.8px;color:var(--ink-soft);max-width:44em}\n  details p + p{margin-top:-6px}\n\n  .faq-group-title{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:12px;letter-spacing:.24em;color:var(--ink-faint);margin:36px 0 4px}\n  .faq-group-title:first-child{margin-top:0}\n\n  /* ---------- 底部固定导航 ---------- */\n  nav.dock{position:fixed;left:0;right:0;bottom:0;background:rgba(242,242,244,.94);border-top:1px solid var(--line);backdrop-filter:blur(6px);z-index:20}\n  .dock-inner{max-width:1080px;margin:0 auto;padding:12px 22px;display:flex;flex-wrap:wrap;gap:6px 22px;align-items:center;justify-content:space-between;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:13px}\n  .dock-links{display:flex;flex-wrap:wrap;gap:6px 20px}\n  .dock-links a{color:var(--ink-soft);text-decoration:none;border-bottom:1px solid transparent;padding-bottom:1px}\n  .dock-links a:hover,\n  .dock-links a:focus{color:var(--violet);border-bottom-color:var(--violet)}\n  .dock-brand{color:var(--ink-faint);font-size:12px;letter-spacing:.14em}\n\n  footer.colophon{padding:56px 0 40px;border-top:1px solid var(--line);font-size:13px;color:var(--ink-faint)}\n  footer.colophon p{margin:0 0 8px}\n\n  @media (max-width:820px){\n    .hero-grid{grid-template-columns:1fr;gap:40px}\n    .plan{grid-template-columns:1fr;gap:20px;padding:26px 22px}\n    .read-grid{grid-template-columns:1fr}\n    .steps{grid-template-columns:1fr}\n  }\n  @media (max-width:520px){\n    .hero{padding:36px 0 48px}\n    section.band{padding:48px 0}\n    .masthead-inner{padding:16px 0 14px}\n    .dock-inner{justify-content:center;font-size:12px}\n    .dock-brand{width:100%;text-align:center;order:2}\n    body{padding-bottom:86px}\n  }\n</style><header class=\"masthead\">\n  <div class=\"wrap masthead-inner\">\n    <div class=\"brandmark\">盼盼加速<span>PANPAN</span></div>\n    <div class=\"masthead-note\">一份按顺序写的选择说明 · 逐级阅读</div>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">购买之前，先读四行字</p>\n        <h1>盼盼加速<em>先把顺序理清，再谈选择。</em></h1>\n        <p class=\"lead\">大多数人对加速工具的困惑，并不是“哪个更快”，而是“我到底需要多少”。所以这一页不按卖点排列，而是按你打开网页到做出决定的顺序来写：先确认用量，再确认设备数，然后才看价格。</p>\n        <p class=\"lead\">右边的四段是一条时间线，从上往下读即可。读完它，再看下面的套餐，判断会容易得多——因为我们把每一档都写成了“它适合谁”，而不是“它有多强”。</p>\n        <p class=\"hero-sign\">页面内容为产品介绍与方案说明，具体可用性、线路与流量以你实际购买时页面的说明为准。</p>\n      </div>\n\n      <ol class=\"timeline\">\n        <li>\n          <span class=\"step-no\">STEP 01</span>\n          <h3>先估月度用量</h3>\n          <p>翻一遍上个月的使用习惯：只是查资料和聊天，与每天看视频，是两种完全不同的量级。先给一个偏保守的数字。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">STEP 02</span>\n          <h3>再数同时在线设备</h3>\n          <p>手机、笔记本、平板、家里的电视盒子——数的是“可能同时连上去”的台数，而不是你一共拥有几台。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">STEP 03</span>\n          <h3>分清个人还是团队</h3>\n          <p>如果账号要给同事或家人分开使用，那要考虑的就不只是流量，还有管理与沟通成本。</p>\n        </li>\n        <li>\n          <span class=\"step-no\">STEP 04</span>\n          <h3>最后对照价格</h3>\n          <p>把前三个答案带到下面的套餐区，从上往下扫一遍，通常停在某一档时你会觉得“就是它”。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"point\">\n    <div class=\"wrap\">\n      <div class=\"band-head\">\n        <h2>四件值得先说清楚的事</h2>\n        <p>这些不是卖点，而是容易在选择过程中被忽略、事后又容易后悔的四个判断点。</p>\n      </div>\n      <div class=\"read-grid\">\n        <article class=\"stripe-card\">\n          <h3>流量是“按月重置”的额度</h3>\n          <p>每月额度在下个计费周期重新开始，不累积到下个月。所以不必为了“用不完浪费”而刻意压低档位，选一个大部分月份都够用的额度更实际。</p>\n        </article>\n        <article class=\"stripe-card\">\n          <h3>设备数指的是同时在线</h3>\n          <p>三台设备不是“只能绑三台”，而是同一时刻最多三台在线。换设备通常不是问题，问题往往出在全家一起用的时候。</p>\n        </article>\n        <article class=\"stripe-card muted\">\n          <h3>流媒体解锁与线路是两件事</h3>\n          <p>能不能看某个平台，和线路稳不稳，是两个独立的问题。基础版提供基础流媒体支持，更高档位则把节点选择范围与线路类型一起放宽。</p>\n        </article>\n        <article class=\"stripe-card muted\">\n          <h3>团队方案的核心是“分得开”</h3>\n          <p>团队版的价值不在流量数字本身，而在于二十台设备、专属带宽节点与定制路由这几项同时在场时，多人协作不会互相干扰。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"band-head\">\n        <h2>三档方案，从上往下读</h2>\n        <p>按由轻到重的顺序排列。中间那档是多数个人用户最终会停留的位置，但它不一定适合你——先看每档开头那句“适合谁”。</p>\n      </div>\n\n      <div class=\"plan-stack\">\n\n        <article class=\"plan\">\n          <div>\n            <h3>基础版</h3>\n            <p class=\"pitch\">适合用量克制、设备不多的个人用户：以资料查阅、日常通讯和轻度影音为主，一个月里大多数日子并不需要把带宽拉满。</p>\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>最多 3 台设备同时在线</li>\n              <li>支持基础流媒体播放</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </div>\n          <div class=\"price-block\">\n            <p class=\"price\">¥15<small> / 月</small></p>\n            <p class=\"price-note\">按年付 ¥150 / 年</p>\n            <p class=\"price-foot\">月付与年付为两种计费周期，额度均按月重置。具体支付方式与实际开通说明以购买页为准。</p>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <div>\n            <span class=\"tag\">多数个人用户的选择</span>\n            <h3>旗舰版</h3>\n            <p class=\"pitch\">适合把网络当作日常主力工具的人：既要看片，也玩游戏，还要几台设备来回切换。它把额度、设备数和线路类型一起放宽一档。</p>\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>最多 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁支持</li>\n              <li>IPLC 专线，面向游戏场景做优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n          </div>\n          <div class=\"price-block\">\n            <p class=\"price\">¥35<small> / 月</small></p>\n            <p class=\"price-note\">按年付 ¥350 / 年</p>\n            <p class=\"price-foot\">年付相当于用十个月的价格覆盖十二个月。是否值得，取决于你预计的持续使用时长。</p>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <h3>团队版</h3>\n            <p class=\"pitch\">适合多人共用一个账号体系的小团队：设备数量多、需要固定带宽、希望路由能按自己的结构安排，并且希望有问题时能找到具体的人。</p>\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>最多 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </div>\n          <div class=\"price-block\">\n            <p class=\"price\">¥85<small> / 月</small></p>\n            <p class=\"price-note\">按年付 ¥850 / 年</p>\n            <p class=\"price-foot\">定制路由与客户经理服务需在购买前沟通具体需求，实际可执行范围以沟通结果为准。</p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"band-head\">\n        <h2>拿到账号之后，按这个次序做</h2>\n        <p>使用环节最容易出错的地方往往不是配置难，而是顺序错。以下四步建议依次进行。</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <span class=\"num\">01</span>\n          <h3>先在自己的主力设备上完成设置</h3>\n          <p>挑一台最常用的设备先跑通，确认账号可用、额度正常显示，再考虑其他设备。一次只处理一个问题，排查成本最低。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">02</span>\n          <h3>再按需要增加第二、第三台</h3>\n          <p>每加一台，就确认一次还能否正常连接。这样可以明确知道哪一步引入了问题，而不是全部加完才发现异常。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">03</span>\n          <h3>把额度用量放进日常节奏里看</h3>\n          <p>头一个月留意用量走势：如果月中就接近上限，说明档位偏紧；如果长期只用掉一小部分，可以考虑下调。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">04</span>\n          <h3>遇到问题先记录现象再反馈</h3>\n          <p>记下发生时间、设备类型、当时的网络环境与具体表现。描述得越具体，工单往返的次数就越少。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"band-head\">\n        <h2>客户端：用你手上已有的那一套</h2>\n        <p>盼盼加速不要求你更换系统或设备。账号建立之后，通过你日常使用的客户端完成配置即可。下面按场景说明，不涉及具体下载地址——请以账号内的指引为准。</p>\n      </div>\n      <div class=\"read-grid\">\n        <article class=\"stripe-card\">\n          <h3>桌面端：笔记本与台式机</h3>\n          <p>在电脑上使用时，通常先在账号页确认额度与在线设备数，再在本地客户端的配置文件或订阅入口填入账号提供的信息。建议先在一台电脑上验证通过，再同步到第二台。</p>\n        </article>\n        <article class=\"stripe-card\">\n          <h3>移动端：手机与平板</h3>\n          <p>移动设备更适合作为补充终端。由于手机经常切换网络，测试时应分别在移动数据与 Wi-Fi 下各确认一次，避免把网络切换问题误判为账号问题。</p>\n        </article>\n        <article class=\"stripe-card muted\">\n          <h3>家庭场景：电视盒子与其他设备</h3>\n          <p>客厅设备通常长期在线，会持续占用一个同时在线名额。如果家里设备较多，建议先在纸面上排一下“谁会同时开”，再决定档位。</p>\n        </article>\n        <article class=\"stripe-card muted\">\n          <h3>团队场景：多账号的秩序</h3>\n          <p>团队版涉及多人使用时，建议先确定一位对接人，统一收集问题与需求，再与客户经理沟通。这比每个人各自反馈更省时间，也更不容易遗漏。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"band-head\">\n        <h2>常见问题</h2>\n        <p>下面这些问题按主题分成三组，点击标题展开。答案尽量写得具体，因为它决定了你最终会停在哪一档。</p>\n      </div>\n\n      <div class=\"faq\">\n\n        <p class=\"faq-group-title\">关于额度与计费</p>\n\n        <details>\n          <summary>每个月没用完的流量会留到下个月吗？</summary>\n          <p>不会。额度按计费周期重置，未使用的部分不累积。因此选择档位时，建议看你“大部分月份”的用量，而不是某个月特别省的用量，也不是某个月特别费的情形。</p>\n        </details>\n\n        <details>\n          <summary>月付和年付有什么实际差别？</summary>\n          <p>主要差别在计费周期与总支出。基础版年付 ¥150、旗舰版年付 ¥350、团队版年付 ¥850；对应的月付价格为 ¥15、¥35、¥85。年付适合已经确定会持续使用较长时间的人，月付则更适合先试用一段时间后再决定。</p>\n        </details>\n\n        <details>\n          <summary>三档之间的额度差距为什么这么大？</summary>\n          <p>因为三档对应的使用形态不同。基础版面向以文字和轻量影音为主的个人；旗舰版容纳日常影音与游戏；团队版需要考虑多人同时在线时额度被快速分摊的情况。额度是结果，场景才是原因。</p>\n        </details>\n\n        <p class=\"faq-group-title\">关于设备与线路</p>\n\n        <details>\n          <summary>“同时在线设备数”具体怎么计算？</summary>\n          <p>指的是同一时刻处于连接状态的设备数量。基础版为 3 台，旗舰版为 5 台，团队版为 20 台。换设备本身通常不是问题，需要注意的是不要超过同时在线的上限。</p>\n        </details>\n\n        <details>\n          <summary>基础版说的“基础流媒体”和旗舰版的解锁有什么不同？</summary>\n          <p>基础版提供基础的流媒体支持，节点来自普通线路节点池；旗舰版则在全部节点上提供原生流媒体解锁支持，并额外包含面向游戏场景优化的 IPLC 专线。如果你主要用来看片和玩游戏，两者的体验差别会更明显。</p>\n        </details>\n\n        <details>\n          <summary>团队版说的“定制路由”是指什么？</summary>\n          <p>指可以按团队自身的网络结构提出路由安排方面的需求，由专属客户经理对接沟通。具体能做到什么程度，需要在实际沟通中确认，页面不做超出沟通结果的承诺。</p>\n        </details>\n\n        <p class=\"faq-group-title\">关于使用与支持</p>\n\n        <details>\n          <summary>我需要额外安装什么软件吗？</summary>\n          <p>不需要更换系统或设备，通过你日常使用的客户端完成配置即可。具体使用哪一款客户端、从哪里获取配置文件，以账号内的指引为准；本页不提供下载地址，也不做兼容性承诺。</p>\n        </details>\n\n        <details>\n          <summary>遇到问题时应该怎么反馈？</summary>\n          <p>优先记录现象：发生的时间、设备类型、当时的网络环境、具体表现，以及是否在别的设备上复现。旗舰版与团队版分别提供优先工单与专属客户经理渠道，信息越完整，处理越直接。</p>\n        </details>\n\n        <details>\n          <summary>可以先从基础版开始，之后再加档吗？</summary>\n          <p>档位之间的差别主要在额度、设备数与线路类型，因此不少人的路径是先按较低档位用一段时间，确认自己的真实用量之后再调整。建议第一个月留意用量走势，再做决定。</p>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<nav class=\"dock\" aria-label=\"页面内导航\">\n  <div class=\"dock-inner\">\n    <span class=\"dock-brand\">盼盼加速 · PANPAN</span>\n    <div class=\"dock-links\">\n      <a href=\"#point\">先读四点</a>\n      <a href=\"#plans\">三档方案</a>\n      <a href=\"#howto\">使用次序</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</nav>\n\n<footer class=\"colophon\">\n  <div class=\"wrap\">\n    <p>盼盼加速 · 本页为产品与方案说明，用于帮助判断适合的档位。</p>\n    <p>价格、额度、设备数与线路类型以购买时页面展示为准；未在本页列出的服务内容，不作默认承诺。</p>\n  </div>\n</footer>",
